# Copy to .env.local and fill in.
# The anon key is public by design (RLS = SELECT only). The service_role key
# must never appear here — it belongs to n8n exclusively.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUBACCOUNT=formula-fitness

# Optional — where the drill-down links to. Defaults to the Formula Fitness
# subaccount. The location id is public (it is in every GHL page URL).
NEXT_PUBLIC_GHL_APP_ORIGIN=https://app.formulafitness.co
NEXT_PUBLIC_GHL_LOCATION_ID=pyBwacgonEauKuE1akJb
